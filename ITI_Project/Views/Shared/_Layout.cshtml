<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E-Commerce</title> <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /> <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /> <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #f6f8fc;
            color: #1f2937;
        }
        /* ================= SIDEBAR ================= */

        .sidebar {
            width: 250px;
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: #111827;
            padding: 25px 15px;
            z-index: 1000;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            color: white;
            text-decoration: none;
            font-size: 21px;
            font-weight: 700;
            padding: 0 12px 30px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: #6366f1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .menu-title {
            color: #6b7280;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            padding: 0 12px;
            margin-bottom: 10px;
        }

        .sidebar .nav-link {
            color: #9ca3af;
            padding: 12px 14px;
            margin-bottom: 5px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: 0.2s;
        }

            .sidebar .nav-link i {
                font-size: 18px;
            }

            .sidebar .nav-link:hover {
                background: #1f2937;
                color: white;
            }

            .sidebar .nav-link.active {
                background: #6366f1;
                color: white;
            }

        .logout-link {
            position: absolute;
            bottom: 25px;
            left: 15px;
            right: 15px;
        }
        /* ================= MAIN ================= */

        .main {
            margin-left: 250px;
            min-height: 100vh;
        }
        /* ================= TOPBAR ================= */

        .topbar {
            height: 75px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
        }

        .page-title {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #111827;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #6366f1;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .user-name {
            font-size: 14px;
            font-weight: 600;
        }

        .user-role {
            font-size: 11px;
            color: #9ca3af;
        }
        /* ================= CONTENT ================= */

        .content {
            padding: 30px;
        }
        /* ================= STAT CARDS ================= */

        .stat-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 22px;
            height: 100%;
            transition: 0.2s;
        }

            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.06);
            }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
            margin-bottom: 18px;
        }

        .icon-purple {
            background: #eef2ff;
            color: #6366f1;
        }

        .icon-blue {
            background: #eff6ff;
            color: #3b82f6;
        }

        .icon-green {
            background: #ecfdf5;
            color: #10b981;
        }

        .icon-orange {
            background: #fff7ed;
            color: #f97316;
        }

        .stat-title {
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 5px;
        }

        .stat-number {
            font-size: 25px;
            font-weight: 700;
            color: #111827;
        }
        /* ================= CONTENT CARDS ================= */

        .dashboard-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 16px;
            padding: 22px;
        }

        .card-title {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 20px;
        }
        /* ================= TABLE ================= */

        .table {
            margin-bottom: 0;
        }

            .table thead th {
                background: #f9fafb;
                color: #6b7280;
                font-size: 12px;
                font-weight: 600;
                border-bottom: 1px solid #e5e7eb;
                padding: 13px;
            }

            .table tbody td {
                padding: 15px 13px;
                vertical-align: middle;
                font-size: 13px;
                border-bottom: 1px solid #f1f5f9;
            }

        .product-name {
            font-weight: 600;
            color: #111827;
        }

        .badge-status {
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .status-active {
            background: #ecfdf5;
            color: #059669;
        }

        .status-low {
            background: #fff7ed;
            color: #ea580c;
        }
        /* ================= RESPONSIVE ================= */

        @@media (max-width: 992px) {
            .sidebar {
                width: 75px;
            }

                .brand span, .menu-title, .sidebar .nav-link span {
                    display: none;
                }

            .brand {
                justify-content: center;
            }

            .sidebar .nav-link {
                justify-content: center;
            }

            .main {
                margin-left: 75px;
            }
        }

        @@media (max-width: 576px) {
            .sidebar {
                display: none;
            }

            .main {
                margin-left: 0;
            }

            .content {
                padding: 15px;
            }

            .topbar {
                padding: 0 15px;
            }

            .user-info {
                display: none;
            }
        }
    </style>
</head>
<body>
    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar">
        <a href="#" class="brand">
            <div class="brand-icon">
                <i class="bi bi-bag-check"></i>
            </div>
            <span>E-Commerce</span>
        </a>
        <div class="menu-title"> Main Menu </div>
        <nav class="nav flex-column">
            <a class="nav-link" asp-controller="Product" asp-action="Index">
                <i class="bi bi-box-seam"></i>
                <span>Products</span>
            </a>
            <a class="nav-link" asp-controller="Category" asp-action="Index">
                <i class="bi bi-tags"></i>
                <span>Categories</span>
            </a>
            <a class="nav-link" asp-controller="AI" asp-action="Index">
                <i class="bi bi-robot"></i>
                <span>AI Assistant</span>
            </a>

        </nav>
        <div class="logout-link">
            <a class="nav-link" asp-controller="User" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>
    <!-- ================= MAIN ================= -->
    <main class="main">
        <!-- TOPBAR -->

        <header class="topbar">
            <h1 class="page-title"> @ViewData["Title"] </h1>
            <div class="topbar-right">               
                <div class="user-info">
                    <div class="avatar"> @(Context.Session.GetString("UserName")?.Substring(0,1).ToUpper() ?? "G") </div>
                    <div>
                        <div class="user-name"> @(Context.Session.GetString("UserName") ?? "Guest")  </div>
                    </div>
                </div>
            </div>
        </header> <!-- PAGE CONTENT -->
        <section class="content">
            @RenderBody()
        </section>
    </main>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"> </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>