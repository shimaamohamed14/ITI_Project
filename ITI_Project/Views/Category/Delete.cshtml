@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Category</h1>
<br />

<h3>Are you sure you want to delete this Category?</h3>

@model Category

<div class="card" style="width: 18rem;">
    <div class="card-body">
        <p class="card-title">@Html.DisplayNameFor(p => p.Name): @Model.Name</p>
        <p class="card-title">@Html.DisplayNameFor(p => p.Description): @Model.Description</p>

        <form asp-action="DeleteConfirmed" asp-route-id="@Model.CategoryId" method="post">

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>

    </div>
</div>
